# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=homefix_db
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Payment Gateway & Platform Commission Configuration
# Mode: 'demo' (for college project/offline evaluation without PAN/merchant account)
#       'razorpay' (for live/test Razorpay API with actual keys)
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret
PLATFORM_FEE_PERCENT=10

